# Myelin v10 -- Environment Configuration
# Copy to .env and fill in your values.

# Database (default works out of the box)
DATABASE_URL="file:./data/myelin.db"
NODE_ENV="development"

# --- LLM Provider (pick one) ---

# Option A: Anthropic API key
# ANTHROPIC_API_KEY=sk-ant-...

# Option B: AWS Bedrock
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Option C: Claude OAuth (no env vars needed -- run `claude` CLI to log in)

# --- Claude Code binary path ---
# Required. Path to the Claude Code executable used by the Agent SDK.
# Find it with: which claude
# CLAUDE_CODE_PATH=/usr/local/bin/claude

# --- Optional: Langfuse (agent observability) ---
# Sign up at https://cloud.langfuse.com (free tier available)
# Leave blank to disable.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Optional: Composio (tool gallery search) ---
# COMPOSIO_API_KEY=
